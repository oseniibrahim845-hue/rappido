  {
   "id": "199693fb-73a2-437a-b851-e39bc81144ba",
   "name": "Known Emails List",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    720,
    600
   ],
   "parameters": {
    "jsCode": "return [{json:{emails:$input.all().map(i=>String(i.json.email||'').toLowerCase()).filter(Boolean)}}];"
   }
  },
  {
   "id": "ec84062a-3de7-4a44-af7d-76bbaf4574a3",
   "name": "Classify Mail",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    960,
    600
   ],
   "parameters": {
    "jsCode": "\n// Input: the list of known lead emails. Mails come from the Mail Feed node as { from, subject, text }. Output: { kind: 'bounce'|'reply'|'ignore', email }\nconst known = ($input.first().json.emails || []).map(e => e.toLowerCase());\nconst out = [];\nfor (const it of $('Mail Feed').all()) {\n  const m = it.json;\n  const from = String(m.from || '').toLowerCase();\n  const text = String(m.text || m.textPlain || '');\n  const isBounce = /mailer-daemon|postmaster|mail delivery|delivery status/.test(from + ' ' + String(m.subject || '').toLowerCase());\n  if (isBounce) {\n    const cand = (text.match(/[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}/g) || []).map(e => e.toLowerCase());\n    const hit = cand.find(e => known.includes(e));\n    out.push({ json: { kind: hit ? 'bounce' : 'ignore', email: hit || '' } });\n    continue;\n  }\n  const sender = (from.match(/[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}/) || [''])[0];\n  out.push({ json: { kind: known.includes(sender) ? 'reply' : 'ignore', email: sender } });\n}\nreturn out.filter(o => o.json.kind !== 'ignore');\n"
   }
  },

      ]
    },
    {
      "parameters": {
        "maxItems": 1
      },
      "id": "b97eea74-915e-4a20-acec-01ada5a66d69",
      "name": "Pick Next Prospect",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ String($json.Email).trim() }}",
        "subject": "=Quick idea for {{ ($json['Company'] || $json['Company Name'] || $json['company'] || 'your team') }}",
        "emailType": "text",
        "message": "=Hi {{ (String($json['Contact Name'] || $json['Name'] || $json['First Name'] || $json['contact_name'] || '').trim().split(' ')[0] || 'there') }},\n\nI came across {{ ($json['Company'] || $json['Company Name'] || $json['company'] || 'your team') }} and I think a custom dashboard could save your team real time on reporting.\n{{ ($json['Dashboard Opportunity'] || $json['Opportunity'] || $json['dashboard_opportunity'] || $json['Pain Point'] || $json['pain_point'] || '') ? '\\nWhat I have in mind: ' + ($json['Dashboard Opportunity'] || $json['Opportunity'] || $json['dashboard_opportunity'] || $json['Pain Point'] || $json['pain_point'] || '') + '\\n' : '' }}\nI build custom business dashboards and internal tools (sales, operations, trading and finance reporting) that pull your data together in one place, updated automatically. I can put together a short mock-up for {{ ($json['Company'] || $json['Company Name'] || $json['company'] || 'your team') }} before we talk. Would a 15-minute call next week be useful?\n\nBest,\nYOUR NAME\nCustom dashboards & internal tools\nyourwebsite.com\n\nP.S. If this isn't relevant, just reply \"no thanks\" and I won't email you again.",
        "options": {
          "appendAttribution": false,
          "senderName": "YOUR NAME"
        }
      },
      "id": "890412ed-2e42-4104-99e9-a18e51d3e54c",
      "name": "Send Email (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,

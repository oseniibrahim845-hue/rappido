        }
      },
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "// Picks the next prospect that has an email and hasn't been contacted,\n// then builds a personalised email. One email per run.\nconst SENDER_NAME = 'YOUR NAME';\nconst SENDER_SIGNATURE = 'YOUR NAME\\nCustom dashboards & internal tools\\nyourwebsite.com';\n\nconst rows = $input.all().map(i => i.json);\nconst next = rows\n  .filter(r => String(r.email || '').includes('@') && !String(r.status || '').trim())\n  .sort((a, b) => Number(b.intent_score || 0) - Number(a.intent_score || 0))[0];\n\nif (!next) return []; // nothing left to send: the workflow stops quietly\n\nconst first = String(next.contact_name || '').trim().split(' ')[0] || 'there';\nconst hook = next.evidence_type === 'public_request'\n  ? `I saw ${next.company}'s post looking for automation and developer help.`\n  : `I noticed ${next.company} is hiring for data, reporting and internal-tools work.`;\nconst opportunity = String(next.dashboard_opportunity || '').replace(/\\.$/, '');\n\nconst body = `Hi ${first},\n\n${hook} ${next.outreach_angle}\n\nWhat I have in mind for you: ${opportunity}.\n\nI build custom dashboards and internal tools (${next.recommended_stack}) and can put together a short mock-up for ${next.company} before we talk. Would a 15-minute call next week be useful?\n\nBest,\n${SENDER_SIGNATURE}\n\nP.S. If this isn't relevant, just reply \"no thanks\" and I won't email you again.`;\n\nreturn [{ json: {\n  row_email: next.email,\n  to: next.email,\n  subject: `Idea for ${next.company}'s reporting`,\n  body,\n  sender_name: SENDER_NAME,\n} }];"
      },
      "id": "7118dfeb-e60e-4cb5-b305-0dbe9772aecb",
      "name": "Pick next prospect + write email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "amount": "={{ Math.floor(Math.random() * 180) }}",
        "unit": "seconds"
      },
      "id": "6dea0f67-5216-4974-a710-4636289caf80",

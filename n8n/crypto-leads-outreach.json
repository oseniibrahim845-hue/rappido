    },
    {
      "parameters": {
        "jsCode": "// ===== EDIT THESE =====\nconst YOUR_NAME = 'Your Name';\nconst YOUR_COMPANY = 'Your Company';\nconst CALENDAR_LINK = 'https://cal.com/your-link';\n// ======================\n\nconst BAD_NAMES = ['github actions', 'github-actions', 'bot', 'admin', 'support', 'team'];\n\nreturn $input.all().map(item => {\n  const lead = item.json;\n  const rawName = String(lead['Contact name'] || '').trim();\n  const firstName = rawName.split(/\\s+/)[0];\n  const greeting = rawName && !BAD_NAMES.includes(rawName.toLowerCase())\n    ? `Hi ${firstName},` : 'Hi there,';\n\n  const project = String(lead['Project / package'] || 'your project').trim();\n  const service = String(lead['Suggested service fit'] || 'trading bot development')\n    .split(';')[0].trim();\n  const chains = String(lead['Exchanges / chains'] || '').split(',').slice(0, 3)\n    .map(s => s.trim()).filter(Boolean).join(', ');\n\n  const subject = `Quick idea for ${project}`;\n  const body = `${greeting}\n\nI came across ${project} on ${lead['Source'] || 'GitHub'} and liked what you're building${chains ? ` around ${chains}` : ''}.\n\nI'm ${YOUR_NAME} from ${YOUR_COMPANY} - we build and maintain custom crypto trading infrastructure, especially ${service} projects: low-latency execution, exchange/DEX integrations, risk controls and monitoring.\n\nIf you ever need extra hands to ship features faster or harden ${project} for production, I'd be glad to help. Would you be open to a short 15-minute call? You can grab a slot here: ${CALENDAR_LINK}\n\nBest,\n${YOUR_NAME}\n${YOUR_COMPANY}\n\nP.S. If this isn't relevant, just reply \"no thanks\" and I won't contact you again.`;\n\n  return { json: { ...lead, subject, body } };\n});"
      },
      "id": "n5",
      "name": "Build Personalized Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "n6",
      "name": "Loop Over Leads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        960,
        100
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {
          "appendAttribution": false,
          "senderName": "Your Name"
        }
      },
      "id": "n7",

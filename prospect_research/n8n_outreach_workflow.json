{
  "name": "Prospect Outreach - 20 emails every 4 hours",
  "nodes": [
    {
      "parameters": {
        "content": "## Prospect outreach drip\nSends **1 email every 12 minutes, around the clock** = **20 emails every 4 hours** (120/day).\n\nTo change the pace, edit the trigger's cron: `*/12 * * * *`. Limit hours with e.g. `*/12 8-19 * * *`.\n\n1. Upload `Trading_Bot_and_Business_Dashboard_Prospects.xlsx` to Google Drive and open it as a Google Sheet (tab name: `Prospects`).\n2. Paste the sheet URL into **Read Prospects** and **Mark as Sent / Mark as Failed**.\n3. Connect your Google Sheets + Gmail credentials.\n4. Set the workflow timezone (Settings) to yours.\n5. Test with **Test workflow**, then toggle **Active**.\n\nOnly rows with an **Email** and an empty **Status** are sent. Each sent row gets `Status = Sent <date>` so nobody is emailed twice.",
        "height": 380,
        "width": 420
      },
      "id": "a1f0c0de-0001-4000-8000-000000000001",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -440
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/12 * * * *"
            }
          ]
        }
      },
      "id": "a1f0c0de-0002-4000-8000-000000000002",
      "name": "Every 12 min (20 per 4 hours)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "PASTE_YOUR_GOOGLE_SHEET_URL_HERE"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Prospects"
        },
        "options": {}
      },
      "id": "a1f0c0de-0003-4000-8000-000000000003",
      "name": "Read Prospects",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ String($json.Email || '').trim() }}",
              "rightValue": "@",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ String($json.Status || '').trim() }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            },
            {
              "id": "c3",
              "leftValue": "={{ String($json.Body || '').trim() }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c0de-0004-4000-8000-000000000004",
      "name": "Has Email & Not Yet Sent",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "maxItems": 1
      },
      "id": "a1f0c0de-0005-4000-8000-000000000005",
      "name": "Pick Next Prospect",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.Email.trim() }}",
        "subject": "={{ $json.Subject }}",
        "emailType": "text",
        "message": "={{ $json.Body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a1f0c0de-0006-4000-8000-000000000006",
      "name": "Send Email (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        880,
        0
      ],
      "webhookId": "a1f0c0de-0006-4000-8000-0000000000aa",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "PASTE_YOUR_GOOGLE_SHEET_URL_HERE"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Prospects"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Company": "={{ $('Pick Next Prospect').item.json.Company }}",
            "Status": "=Sent {{ $now.toFormat('yyyy-LL-dd HH:mm') }}"
          },
          "matchingColumns": [
            "Company"
          ],
          "schema": [
            {
              "id": "Company",
              "displayName": "Company",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Status",
              "displayName": "Status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      },
      "id": "a1f0c0de-0007-4000-8000-000000000007",
      "name": "Mark as Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1120,
        -100
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "PASTE_YOUR_GOOGLE_SHEET_URL_HERE"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Prospects"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Company": "={{ $('Pick Next Prospect').item.json.Company }}",
            "Status": "=Failed {{ $now.toFormat('yyyy-LL-dd HH:mm') }}: {{ ($json.error && ($json.error.message || $json.error)) || 'send error' }}"
          },
          "matchingColumns": [
            "Company"
          ],
          "schema": [
            {
              "id": "Company",
              "displayName": "Company",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Status",
              "displayName": "Status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      },
      "id": "a1f0c0de-0008-4000-8000-000000000008",
      "name": "Mark as Failed",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1120,
        100
      ]
    }
  ],
  "connections": {

      "id": "a1f0c0de-0008-4000-8000-000000000008",
      "name": "Mark as Failed",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1120,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalise headers (Email / email / E-mail / 'Email ' all work) and pick the next unsent prospect.\nconst pick = (row, names) => {\n  for (const key of Object.keys(row)) {\n    if (names.includes(key.trim().toLowerCase())) return String(row[key] ?? '').trim();\n  }\n  return '';\n};\n\nconst rows = $input.all().map(i => i.json);\nconst eligible = rows\n  .map(r => ({\n    Company: pick(r, ['company']),\n    Email: pick(r, ['email', 'e-mail', 'email address']),\n    Subject: pick(r, ['subject']),\n    Body: pick(r, ['body', 'message']),\n    Status: pick(r, ['status']),\n  }))\n  .filter(r => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(r.Email) && !r.Status && r.Subject && r.Body && r.Company);\n\nif (eligible.length === 0) {\n  // Nothing to send: stop here. Open this node's output to see why.\n  const withEmail = rows.filter(r => /@/.test(pick(r, ['email', 'e-mail', 'email address']))).length;\n  const alreadySent = rows.filter(r => pick(r, ['status']) !== '').length;\n  return [{ json: { nothing_to_send: true, rows_read: rows.length, rows_with_email: withEmail, rows_with_status_filled: alreadySent,\n    headers_found: Object.keys(rows[0] || {}) } }];\n}\nreturn [{ json: { ...eligible[0], remaining_after_this: eligible.length - 1 } }];\n"
      },
      "id": "a1f0c0de-0009-4000-8000-000000000009",

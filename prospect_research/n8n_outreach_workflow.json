{
  "name": "Prospect Outreach - 20 emails every 4 hours",
  "nodes": [
    {
      "parameters": {
        "content": "## Prospect outreach drip\nSends **1 email every 12 minutes** = **20 emails every 4 hours**.\n\n1. Your Google Sheet needs these columns (any capitalisation): **email**, **subject**, **body**, **Status** (add an empty `Status` column if missing).\n2. Select your sheet + tab in **Read Prospects**, **Mark as Sent** and **Mark as Failed**.\n3. Connect Google Sheets + Gmail credentials.\n4. Click **Execute workflow** to test, then **Publish**.\n\nRows with an email and an empty Status are sent one at a time; each gets `Status = Sent <date>` so nobody is emailed twice.",
        "height": 330,
        "width": 420
      },
      "id": "a1f0c0de-0001-4000-8000-000000000001",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        -380
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/12 * * * *"
            }
          ]
        }
      },
      "id": "a1f0c0de-0002-4000-8000-000000000002",
      "name": "Every 12 min (20 per 4 hours)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "PASTE_YOUR_GOOGLE_SHEET_URL_HERE"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Prospects"
        },
        "options": {}
      },
      "id": "a1f0c0de-0003-4000-8000-000000000003",
      "name": "Read Prospects",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String($json.Email ?? $json.email ?? $json.email_address ?? $json['Email Address'] ?? $json.contact_email ?? '').trim()) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ String($json.Status ?? $json.status ?? '').trim() }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            },
            {
              "id": "c3",
              "leftValue": "={{ String($json.Subject ?? $json.subject ?? $json.subject_line ?? $json.email_subject ?? '').trim() }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c4",
              "leftValue": "={{ String($json.Body ?? $json.body ?? $json.email_body ?? $json.message ?? $json.Message ?? '').trim() }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c0de-0004-4000-8000-000000000004",
      "name": "Has Email & Not Yet Sent",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "maxItems": 1
      },
      "id": "a1f0c0de-0005-4000-8000-000000000005",
      "name": "Pick Next Prospect",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ String($json.Email ?? $json.email ?? $json.email_address ?? $json['Email Address'] ?? $json.contact_email ?? '').trim() }}",
        "subject": "={{ String($json.Subject ?? $json.subject ?? $json.subject_line ?? $json.email_subject ?? '').trim() }}",
        "emailType": "text",
        "message": "={{ String($json.Body ?? $json.body ?? $json.email_body ?? $json.message ?? $json.Message ?? '').trim() }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a1f0c0de-0006-4000-8000-000000000006",
      "name": "Send Email (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        880,
        0
      ],
      "webhookId": "a1f0c0de-0006-4000-8000-0000000000aa",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "PASTE_YOUR_GOOGLE_SHEET_URL_HERE"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Prospects"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{ $('Pick Next Prospect').item.json.row_number }}",
            "Status": "=Sent {{ $now.toFormat('yyyy-LL-dd HH:mm') }}"
          },
          "matchingColumns": [
            "row_number"
          ],
          "schema": [
            {
              "id": "row_number",
              "displayName": "row_number",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "canBeUsedToMatch": true,
              "readOnly": true
            },
            {
              "id": "Status",
              "displayName": "Status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      },
      "id": "a1f0c0de-0007-4000-8000-000000000007",
      "name": "Mark as Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1120,
        -100
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "PASTE_YOUR_GOOGLE_SHEET_URL_HERE"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Prospects"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{ $('Pick Next Prospect').item.json.row_number }}",
            "Status": "=Failed {{ $now.toFormat('yyyy-LL-dd HH:mm') }}: {{ String(($json.error && ($json.error.message || $json.error)) || 'send error').slice(0,200) }}"
          },
          "matchingColumns": [
            "row_number"
          ],
          "schema": [
            {
              "id": "row_number",
              "displayName": "row_number",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "canBeUsedToMatch": true,
              "readOnly": true
            },
            {
              "id": "Status",
              "displayName": "Status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      },
      "id": "a1f0c0de-0008-4000-8000-000000000008",
      "name": "Mark as Failed",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1120,
        100
      ]
    }
  ],
  "connections": {
